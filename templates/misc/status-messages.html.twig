{#
/**
 * @file
 * Theme override for status messages.
 *
 * Displays status, error, and warning messages, grouped by type.
 *
 * An invisible heading identifies the messages for assistive technology.
 * Sighted users see a colored box. See
 * https://www.w3.org/TR/WCAG-TECHS/H69.html for info.
 *
 * Add an ARIA label to the contentinfo area so that assistive technology
 * user agents will better describe this landmark.
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 * - status_headings: List of all status types.
 * - attributes: HTML attributes for the element, including:
 *   - class: HTML classes.
 */
#}
{{ attach_library('beeswax/messages') }}

{# Colours come from the --bw-* tokens (task 0016, 0022), so each type follows the palette and dark mode. #}
{% set message_variants =
  html_cva(
    base: [
      'message-item pointer-events-auto flex max-h-[calc(100vh-12rem)] flex-row items-start gap-2',
      'overflow-y-auto rounded-md border-l-4 p-4 text-foreground shadow-lg',
      'transition-all duration-300 ease-out'
    ],
    variants: {
      type: {
        status: 'border-ok bg-ok-tint',
        info: 'border-info bg-info-tint',
        warning: 'border-warning bg-warning-tint',
        error: 'border-critical bg-critical-tint'
      }
    }
  )
%}

{% set icon_variants =
  html_cva(
    base: 'my-auto',
    variants: {
      type: {
        status: 'text-ok',
        info: 'text-info',
        warning: 'text-warning',
        error: 'text-critical'
      }
    }
  )
%}

{% set close_button_classes =
  [
    'shrink-0 cursor-pointer rounded p-1 transition-colors hover:bg-foreground/10',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground'
  ]|join(' ')
%}

{% set type_icons = {
  status: 'check-circle',
  info: 'info',
  warning: 'warning',
  error: 'x-circle'
} %}

<div
  data-drupal-messages
  class="pointer-events-none fixed right-0 bottom-4 left-0 z-50 flex flex-col gap-3 px-4 sm:right-4 sm:left-auto sm:max-w-lg sm:p-0 md:max-w-xl xl:max-w-2xl"
>
  {% for type, messages in message_list %}
    {% set message_role = type == 'error' ? 'alert' : 'status' %}
    <div
      class="{{
      message_variants.apply({
        type: type
      })
      }}"
      data-message-item
      role="{{ message_role }}"
    >
      <div class="message-header flex shrink-0">
        <div
          class="message-{{ type }}-icon {{
          icon_variants.apply({
            type: type
          })
          }}"
        >
          {{
            include(
              '@beeswax/components/icon/icon.twig',
              {
                icon: type_icons[type]|default('info'),
                icon_size: 'medium'
              },
              with_context: false
            )
          }}
        </div>
        <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
      </div>
      <div class="message-body my-auto grow text-base xl:text-lg [&_a]:underline [&_a]:underline-offset-2">
        {% if (messages|length) > 1 %}
          <ul class="flex list-none flex-col gap-2 px-0">
            {% for message in messages %}
              <li>{{ message }}</li>
            {% endfor %}
          </ul>
        {% else %}
          {{ messages|first }}
        {% endif %}
      </div>
      <button type="button" class="{{ close_button_classes }}" data-message-close aria-label="{{ 'Close message'|t }}">
        {{
          include(
            '@beeswax/components/icon/icon.twig',
            {
              icon: 'x',
              icon_size: 'small'
            },
            with_context: false
          )
        }}
      </button>
    </div>
  {% endfor %}
</div>
